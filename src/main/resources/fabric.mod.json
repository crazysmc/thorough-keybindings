{
  "schemaVersion": 1,
  "id": "thorough-keybindings",
  "version": "${version}",
  "name": "Thorough Keybindings",
  "description": "Make all keybindings configurable",
  "authors": [ "crazysmc" ],
  "contributors": [
    "permail"
  ],
  "contact": {
    "homepage": "https://github.com/crazysmc/thorough-keybindings",
    "sources": "https://github.com/crazysmc/thorough-keybindings",
    "issues": "https://github.com/crazysmc/thorough-keybindings/issues"
  },
  "icon": "assets/thorough-keybindings/icon.png",
  "license": "MIT",
  "environment": "client",
  "depends": {
    "minecraft": "${minecraft_range}",
    "fabricloader": ">=0.17.0",
    "fabric-key-mapping-api-v1": "*"
  },
  "recommends": {
    "fabric-resource-loader-v0": "*"
  },
  "entrypoints": {
    "client": [ "io.github.crazysmc.thrkbs.version.Initializer" ]
